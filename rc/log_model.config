[type glog]
activation: implicit

[format glog]
pattern: (.)([0-9]{2})([0-9]{2}) ([0-9]{2})(:)([0-9]{2})(:)([0-9]{2})(\.)([0-9]+) ([0-9]+) (([^ ]+?)((.)([a-z])*)?)(:)([0-9]+)(]) (.*)
group: 0 log_type
group: 1 month
group: 2 day
group: 3 hour
group: 4 time_separator
group: 5 minute
group: 6 time_separator
group: 7 seconds
group: 8 time_separator
group: 9 millseconds
group: 10 thread
group: 11 path
group: 12 path_base
group: 13 path_dot_and_extension
group: 14 path_dot
group: 15 path_extension
group: 16 post_path_separator
group: 17 path_line
group: 18 post_path_line_separator
group: 19 message

[format etc_passwd]
pattern: ^([^:]+):([^:]+):([0-9]+):([0-9]+):([^:]*):([^:]+):([^:]+)$
group: 0 username
group: 1 password_placeholder
group: 2 uid
group: 3 gid
group: 4 user_info_gecos
group: 5 home_directory
group: 6 shell

[format etc_shadow]
pattern: ^([^:]+):([^:]+):([0-9]*):([0-9]*):([0-9]*):([0-9]*):([0-9]*):([0-9]*):([^:]*)$
group: 0 username
group: 1 encrypted_password
group: 2 last_change_days
group: 3 min_days_before_change
group: 4 max_days_before_change
group: 5 warn_days_before_expiry
group: 6 expiration_days_after_disable
group: 7 account_expiration_date
group: 8 reserved_field

[format grep-n]
pattern: ^(((.*/)?([^:/.]+))((\.)([^:/]+))?(:)([0-9]+))(:)(.*)
group: 0 path_and_line path
group: 1 path_directory_and_base
group: 2 path_directory
group: 3 path_base
group: 4 path_dot_and_extension
group: 5 path_dot
group: 6 path_extension
group: 7 post_path_separator
group: 8 path_line
group: 9 post_path_line_separator
group: 10 message

[format sanitizer-stack]
pattern: ^\s*(#([0-9]+))\s+((0x)?[0-9a-f]+)\s+in\s+(.+)\s+((.*/)?((.*)(\.)(.*))(:)([0-9]+))$
group: 0 frame_label
group: 1 frame_number
group: 2 memory_address
group: 3 memory_address_prefix
group: 4 function_signature
group: 5 file_and_line
group: 6 path_dir
group: 7 path_base_full
group: 8 path_base
group: 9 path_dot
group: 10 path_extension
group: 11 post_path_separator
group: 12 path_line

[type git_blame_detailed]
activation: implicit

[format git_blame_detailed]
pattern: ^([a-f0-9\^]+)\s+(([^(]+?)\s+)?(\()(.+?)\s+([0-9]{4})(-)([0-9]{2})(-)([0-9]{2})\s+([0-9]{2})(:)([0-9]{2})(:)([0-9]{2})\s+([-+][0-9]{4})\s+([0-9]+)(\)) (.*)$
group: 0 commit_hash
group: 2 path_base
group: 3 parenthesis
group: 4 author
group: 5 year
group: 6 date_separator
group: 7 month
group: 8 date_separator
group: 9 day
group: 10 hour
group: 11 time_separator
group: 12 minute
group: 13 time_separator
group: 14 seconds
group: 15 timezone
group: 16 line_number
group: 17 parenthesis
group: 18 code

[type git_log]
activation: implicit

[format git_log]
pattern: ^(commit) ([a-f0-9]+)$
group: 0 commit_identifier
group: 1 commit_hash_value

[format git_log]
pattern: ^(Author)(:) (.*)
group: 0 author_identifier
group: 1 git_header_colon
group: 2 author_value

[format git_log]
pattern: ^(Date)(:) (.*)
group: 0 date_identifier
group: 1 git_header_colon
group: 2 date_value

[format git_log]
pattern: ^(    (.*))?
group: 1 description_line

[view main]
variable: path_base bold
variable: path_directory cyan
variable: path_extension bold
variable: parenthesis dim
variable: path_line log_type == "glog" ? hash(path + path_line) : dim
variable: thread hash(thread)
variable: commit_hash hash(commit_hash)
variable: author hash(author)
variable: date_separator dim
variable: message log_type == "E" ? red : default
variable: log_type log_type == "E" ? red : default
variable: log_type bold
variable: username username == "root" ? bold : default
variable: uid uid == "0" ? red : green
variable: home_directory home_directory == "/nonexistent" ? dim : bold
variable: password_placeholder password_placeholder == "x" ? dim : bg_red
variable: shell shell == "/usr/sbin/nologin" ? dim : default
variable: time_separator dim
variable: post_path_separator dim
variable: post_path_line_separator dim
variable: path_dot dim
variable: frame_number cyan
variable: memory_address dim
variable: commit_hash_value dim
variable: commit_identifier cyan
variable: author_identifier dim
variable: date_identifier dim
variable: git_header_colon dim

[view file]
variable: path_base bold.union(hash(path))
variable: message log_type == "E" ? red : default
variable: log_type log_type == "E" ? red.union(bold) : default
variable: time_separator dim
variable: post_path_separator dim
variable: path_dot dim
